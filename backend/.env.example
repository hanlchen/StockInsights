# App
APP_ENV=development
API_V1_PREFIX=/api/v1

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:4000

# Database
# Local default (SQLite, no setup required):
DATABASE_URL=sqlite:///./stock_insights.db
# Supabase (production): use the "Connection pooling" string from
# Supabase project settings -> Database -> Connection string -> URI,
# with the postgresql:// scheme swapped to postgresql+psycopg2:// so
# SQLAlchemy uses the psycopg2 driver, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
# Use the pooler (port 6543), not the direct connection (port 5432) --
# Supabase's free tier has a low direct-connection limit, and the pooler is
# what keeps a low-traffic app + the daily GitHub Actions refresh job from
# ever hitting it.

# Cache
CACHE_TTL_SECONDS=900

# Optional tertiary data provider fallback (verify current free-tier limits before relying on it)
ALPHA_VANTAGE_API_KEY=
